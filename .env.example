# ============================================================
# .env.example – Template cho file cấu hình môi trường
# ============================================================
#
# Cách sử dụng:
#   cp .env.example .env
#   # Chỉnh giá trị cho phù hợp, sau đó:
#   docker compose up --build pnad-gui
# ============================================================

# --- SQLite ---
SQLITE_DATABASE_PATH=pnad.db

# --- Docker GUI defaults ---
# These seed the Qt GUI in the container; users can still change paths in the app.
PNAD_GUI_SQLITE_PATH=/data/pnad.db
PNAD_GUI_PCAP_PATH=/samples/multi-asset.pcap
PNAD_GUI_EXPORT_DIR=/out
PNAD_DOCKER_RUNTIME=1

# --- Desktop email alerts ---
# SMTP settings are read from .env/process environment.
# The GUI only allows changing PNAD_EMAIL_RECIPIENTS.
PNAD_EMAIL_ALERTS_ENABLED=false
PNAD_EMAIL_SMTP_HOST=smtp.gmail.com
PNAD_EMAIL_SMTP_PORT=587
PNAD_EMAIL_TLS_MODE=starttls
PNAD_EMAIL_USERNAME=your-email@gmail.com
PNAD_EMAIL_PASSWORD_ENV=PNAD_SMTP_PASSWORD
# Optional direct password value. Prefer exporting PNAD_SMTP_PASSWORD outside tracked files.
PNAD_EMAIL_PASSWORD=
PNAD_SMTP_PASSWORD=
PNAD_EMAIL_FROM=your-email@gmail.com
PNAD_EMAIL_RECIPIENTS=admin@example.com

# Keep the real password out of tracked files:
# export PNAD_SMTP_PASSWORD='your-app-password'

# --- Docker Compose settings ---
COMPOSE_PROJECT_NAME=asset-discovery
